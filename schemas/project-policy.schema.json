{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticxyz.org/schemas/project-policy/0.1.0",
  "title": "AgenticXYZ ProjectPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "productPrinciples", "safetyRules", "privacyRules", "contributionRules", "runtimeRules", "approvalRules", "evidenceRequirements", "protectedInvariants", "defaultBehavior"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "productPrinciples": { "$ref": "#/$defs/rules" },
    "safetyRules": { "$ref": "#/$defs/rules" },
    "privacyRules": { "$ref": "#/$defs/rules" },
    "contributionRules": { "$ref": "#/$defs/rules" },
    "runtimeRules": { "$ref": "#/$defs/rules" },
    "approvalRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "riskLevel", "requiredActor"],
        "properties": {
          "id": { "type": "string" },
          "action": { "type": "string" },
          "riskLevel": { "enum": ["R0", "R1", "R2", "R3"] },
          "requiredActor": { "enum": ["contributor", "maintainer"] }
        }
      }
    },
    "evidenceRequirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "appliesTo", "verifierIds"],
        "properties": {
          "id": { "type": "string" },
          "appliesTo": { "enum": ["user_overlay", "knowledge_gate", "project_candidate"] },
          "verifierIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "protectedInvariants": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "defaultBehavior": { "type": "object" }
  },
  "$defs": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "title", "statement", "effect", "appliesTo"],
        "properties": {
          "id": { "type": "string" },
          "category": { "enum": ["product", "safety", "privacy", "contribution", "runtime"] },
          "title": { "type": "string" }, "statement": { "type": "string" },
          "effect": { "enum": ["allow", "deny", "require_approval", "require_verification"] },
          "appliesTo": { "type": "array", "items": { "enum": ["user-side", "maintainer-side", "project"] } }
        }
      }
    }
  }
}
