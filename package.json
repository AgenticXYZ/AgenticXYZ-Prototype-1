{
  "name": "agenticxyz-prototype-1",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "AgenticXYZ Prototype 1 — Agents with People. Human in the Loop.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n gateway,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts --serve-dist",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts --update-snapshots",
    "record:demo": "tsx scripts/record-demo.ts",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "verify:live-smoke": "tsx scripts/verify-live-smoke.ts",
    "freeze:replay": "tsx scripts/freeze-replay.ts",
    "freeze:reviewed-replay": "tsx scripts/freeze-reviewed-live-smoke.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:replay": "tsx scripts/check-replay.ts",
    "check:reviewed-replay": "tsx scripts/check-reviewed-replay.ts",
    "check:acceptance": "tsx scripts/check-acceptance.ts",
    "check": "npm run typecheck && npm run test && npm run check:secrets && npm run check:replay && npm run check:reviewed-replay && npm run check:acceptance && npm run build",
    "release:audit": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
