# Select exactly one active provider for a run.
AGENTICXYZ_PROVIDER=openai
AGENTICXYZ_MODEL=gpt-5.6-terra

# Current model-ID examples; confirm account availability in each Provider's model catalog:
# OpenAI:   gpt-5.6-terra
# Anthropic: claude-sonnet-4-6
# DeepSeek: deepseek-v4-flash

# Configure only the key required by the selected provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Optional provider overrides for compatible gateways.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_EFFORT=high

# Runtime limits.
AGENTICXYZ_PORT=8787
AGENTICXYZ_MAX_TOOL_CALLS=6
AGENTICXYZ_MAX_PROVIDER_CALLS=1
AGENTICXYZ_MAX_INPUT_TOKENS=20000
AGENTICXYZ_MAX_OUTPUT_TOKENS=32000
AGENTICXYZ_MAX_RETRIES=0
# 0 waits until the Provider returns or a person cancels the run.
AGENTICXYZ_REQUEST_TIMEOUT_MS=0
